#!/usr/bin/env bash
# ============================================================================
# 全局配置 —— 所有脚本 source 此文件
# 修改本文件即可，无需改任何脚本
# ============================================================================

# ------- 集群基础 -------
CLUSTER_NAME="k8s-node1"
NODE_IP="$(hostname -I | awk '{print $1}')"
NODE_HOSTNAME="$(hostname)"

# ------- 镜像加速器（Docker Hub IPv4 被墙！）------
REGISTRY_MIRRORS=(
    "https://docker.m.daocloud.io"
    "https://docker.1panel.live"
)

# registry.k8s.io 加速（metrics-server 等官方镜像）
K8S_REGISTRY_MIRRORS=(
    "k8s.m.daocloud.io"
)

# ------- K8s 组件版本（必须 labring/* 有 ARM64）-------
K8S_VERSION="v1.29.9"        # 稳定 + 长期支持
CALICO_VERSION="v3.28.1"
HELM_VERSION="v3.12.0"
SEALOS_VERSION="v5.1.1"

# ------- 存储 -------
NFS_DIR="/data/nfs"
NFS_SERVER_IP="${NODE_IP}"

# NFS server 调优（单机 loopback，线程数 = CPU 核数 x 4 比较合理）
NFSD_THREADS=32

# ------- Kubelet 稳定性（1TiB RAM 大内存优化）-------
TOTAL_MEM_GB=""              # 留空 = 自动检测
SYSTEM_RESERVED_MEM_GI=""    # 留空 = 总内存 2%（至少 2Gi）
EVICTION_HARD_MEMORY="5%"
EVICTION_HARD_NODEFS="10%"
EVICTION_HARD_IMAGEFS="15%"
MAX_PODS=250                 # 单大节点可放宽（默认 110）
CONTAINER_LOG_MAX_SIZE="100Mi"   # CRI 日志轮转归 kubelet 管
CONTAINER_LOG_MAX_FILES=3
MAX_PARALLEL_IMAGE_PULLS=5   # v1.27+，配合 serializeImagePulls=false

# ------- 日志 —— Fluent Bit (Helm chart) -------
GRAYLOG_HOST="GRAYLOG_HOST_IP_PLACEHOLDER"   # TODO: 填真实 IP
GRAYLOG_PORT="52201"
GRAYLOG_PROTOCOL="udp"
FLUENTBIT_HELM_RELEASE="fluent-bit"

# 要排除的系统命名空间（不进 Graylog，只关心产品服务日志）
LOG_EXCLUDE_NAMESPACES="^(calico-apiserver|calico-system|csi-driver-nfs|default|kube-node-lease|kube-public|kube-system|kuboard|tigera-operator|logging|db)$"

# ------- Kuboard v4（05-kuboard.sh）-------
# 镜像用官方名，由 images-manager.sh 同步 SWR 后 load2k8s 注入集群（打回官方名）
KUBOARD_IMAGE="eipwork/kuboard:v4"
KUBOARD_MYSQL_IMAGE="mysql:8.4"           # kuboard 内置数据库（kuboard 命名空间）
KUBOARD_MYSQL_ROOT_PASSWORD="KuboardMysql2026Root"
KUBOARD_MYSQL_PASSWORD="KuboardMysql2026User"
KUBOARD_MYSQL_STORAGE="10Gi"

# ------- ingress-nginx（06-ingress-nginx.sh，hostNetwork 80/443）-------
INGRESS_NGINX_VERSION="v1.11.3"
WEBHOOK_CERTGEN_VERSION="v1.5.1"   # 已 load（原 v1.4.3，重跑 06 即生效）

# ------- 易用性（09-usability.sh）-------
INSTALL_METRICS_SERVER=true  # kubectl top 需要
METRICS_SERVER_VERSION="v0.7.2"
INSTALL_KUBECTL_ALIASES=true # k / kgp / kgd / kdel 等别名

# ------- Prometheus 监控套件（10-prometheus-stack.sh，自部署 kube-prometheus-stack）-------
# 不用 Kuboard 内置监控套件（其配置会被自动恢复）；镜像由 images-manager.sh 通道人工同步
PROMETHEUS_STACK_CHART_VERSION="90.0.0"
# admission webhook（CR 校验）：用 ingress-nginx 官方 certgen v1.5.1（已 load，实测与 chart 全兼容：
# create/patch 参数一致，且默认证书密钥名 cert/key 与 kps 期望对齐，无需 ghcr.io 的 jkroepke fork）
PROMETHEUS_ADMISSION_WEBHOOKS="true"
KPS_CERTGEN_IMAGE="registry.k8s.io/ingress-nginx/kube-webhook-certgen:v1.5.1"   # 10 号脚本 webhook 证书 Job 用
PROMETHEUS_NAMESPACE="monitoring"
# TSDB 写入为大量小 IO，走本地盘 local-path（/data/k8s/pv），NFS 性能不适合 TSDB
PROMETHEUS_STORAGE_CLASS="local-path"
PROMETHEUS_STORAGE_SIZE="100Gi"
PROMETHEUS_RETENTION="15d"
PROMETHEUS_RETENTION_SIZE="40GB"
PROMETHEUS_CPU_REQ="2";  PROMETHEUS_MEM_REQ="8Gi"
PROMETHEUS_CPU_LIM="4";  PROMETHEUS_MEM_LIM="16Gi"
ALERTMANAGER_STORAGE_CLASS="nfs-client"
ALERTMANAGER_STORAGE_SIZE="2Gi"
GRAFANA_STORAGE_CLASS="nfs-client"
GRAFANA_STORAGE_SIZE="5Gi"
GRAFANA_NODEPORT="30300"
PROMETHEUS_NODEPORT="30900"
ALERTMANAGER_NODEPORT="30903"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD=""    # 留空 = 首次自动生成 20 位随机密码，写入 helm-values/grafana-admin-password.txt

# ------- etcd 自动快照（04-cluster-tuning.sh 挂 cron）-------
ETCD_SNAPSHOT_ENABLED=true
ETCD_SNAPSHOT_DIR="/data/nfs/backup/etcd"
ETCD_SNAPSHOT_KEEP=7         # 保留份数
ETCD_SNAPSHOT_CRON="0 2 * * *"   # 每天 02:00

# ------- DB 服务命名空间 -------
DB_NAMESPACE="db"

# ------- NFS 目录结构约定: /data/nfs/{命名空间}/{服务名}/ -------
# PVC 类存储由 provisioner 按 StorageClass pathPattern 自动落到 {ns}/{pvc名}/ 子目录
# 下面是 db 命名空间的预建目录（DB Helm 直接挂 NFS 子路径时用）
NFS_MYSQL_DIR="${NFS_DIR}/db/mysql"
NFS_REDIS_DIR="${NFS_DIR}/db/redis"
NFS_ES_DIR="${NFS_DIR}/db/es"
NFS_KAFKA_DIR="${NFS_DIR}/db/kafka"
NFS_DORIS_DIR="${NFS_DIR}/db/doris"
NFS_KUBOARD_DIR="${NFS_DIR}/kuboard"

# ------- Elasticsearch (单机模式) -------
ES_HEAP_SIZE="31g"
ES_STORAGE_SIZE="100Gi"

# ------- MySQL -------
MYSQL_ROOT_PASSWORD="your_mysql_root_pwd_change_me"
MYSQL_STORAGE_SIZE="50Gi"

# ------- Redis -------
REDIS_PASSWORD="your_redis_pwd_change_me"
REDIS_STORAGE_SIZE="10Gi"

# ------- Kafka (KRaft, 单机 3 broker 模式) -------
KAFKA_KRAFT_STORAGE_SIZE="50Gi"

# ------- Doris -------
DORIS_VERSION="2.1.7"          # 最新稳定
DORIS_PORT_FE="8030"
DORIS_PORT_BE="9060"
DORIS_INSTALL_DIR="/data/doris"

# ------- GitHub 下载代理 -------
GITHUB_PROXY="https://ghproxy.com/"

# ------- 日志 -------
LOG_DIR="/home/ubuntu/deploy/logs"
LOG_FILE="${LOG_DIR}/deploy-$(date +%Y%m%d-%H%M%S).log"
